---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { getCollection } from "astro:content";
import { SITE } from "../../../config/site.mjs";
import { getFirstContentImage } from "../../../utils/contentImages";

const entries = (await getCollection("diary"))
	.filter((entry) => !entry.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.map((entry) => ({ entry, thumbnail: getFirstContentImage(entry.body) }));
---

<Layout
	title={`Diary | ${SITE.title}`}
	description="日記一覧"
	canonicalURL={`${SITE.url}/blog/diary`}
>
	<Header />
	<main id="main-content" class="mx-auto max-w-3xl px-6 py-12">
		<header class="mb-8">
			<h1 class="text-3xl font-semibold text-gray-900">日記</h1>
			<p class="mt-2 text-gray-600">日々の記録。</p>
		</header>

		{
			entries.length === 0 ? (
				<p class="text-gray-600">まだ記事がありません。</p>
			) : (
				<ul class="space-y-6">
					{entries.map(({ entry, thumbnail }) => (
						<li class="rounded-2xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
							<a
								href={`/blog/diary/${entry.slug}/`}
								class:list={[
									"grid min-h-32",
									thumbnail &&
										"grid-cols-[minmax(0,1fr)_7rem] sm:grid-cols-[minmax(0,1fr)_11rem]",
								]}
							>
								<div class="min-w-0 p-6">
									<p class="text-sm text-gray-500">
										<time datetime={entry.data.date.toISOString()}>
											{entry.data.date.toLocaleDateString("ja-JP")}
										</time>
									</p>
									<h2 class="mt-2 text-xl font-semibold text-gray-900 hover:underline">
										{entry.data.title}
									</h2>
									{entry.data.description && (
										<p class="mt-2 text-gray-600">{entry.data.description}</p>
									)}
								</div>
								{thumbnail && (
									<img
										src={thumbnail}
										alt=""
										class="h-full min-h-32 w-full rounded-r-2xl object-cover"
										loading="lazy"
										decoding="async"
									/>
								)}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</main>
	<Footer />
</Layout>
